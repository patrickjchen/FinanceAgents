# --- LLM backend -------------------------------------------------------------
# LLM_PROVIDER: "openai" (default) or "openrouter". If unset and only
# OPENROUTER_API_KEY is present, openrouter is selected automatically.
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# OpenRouter (https://openrouter.ai) - OpenAI-compatible gateway to many models
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: model id. Defaults to gpt-3.5-turbo (openai) / openai/gpt-3.5-turbo (openrouter).
# OpenRouter examples: deepseek/deepseek-chat, qwen/qwen-2.5-coder-32b-instruct, anthropic/claude-sonnet-4
#LLM_MODEL=deepseek/deepseek-chat
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_SITE_URL=https://github.com/your/repo   # sent as HTTP-Referer
#OPENROUTER_APP_NAME=FinanceAgents                   # sent as X-Title

# --- Hugging Face (optional) -------------------------------------------------
# Only needed if the embedding model download is rate-limited or gated.
# huggingface_hub picks this up automatically.
#HF_TOKEN=hf_...

# --- Reddit ------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
